{
  "name": "ai-platform",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "MASTRA_AUTO_DETECT_URL=true MASTRA_TELEMETRY_DISABLED=1 mastra dev",
    "build": "MASTRA_TELEMETRY_DISABLED=1 mastra build",
    "start": "node .mastra/output/index.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:live": "tsx scripts/smoke.ts --live",
    "run:archive": "tsx scripts/run-archive.ts",
    "eval:development": "tsx scripts/development-eval.ts",
    "review:dev": "npm --prefix web run dev",
    "review:build": "npm --prefix web run build",
    "review:preview": "npm --prefix web run preview",
    "eval:unified": "tsx scripts/unified-eval.ts",
    "eval:fixed:import": "tsx scripts/import-fixed-baseline.ts",
    "eval:review-rework": "tsx scripts/review-rework-eval.ts",
    "eval:development-nodes": "tsx scripts/development-node-eval.ts",
    "eval:development-nodes:seed": "tsx scripts/development-node-eval.ts --seed",
    "eval:product-tool-mock": "tsx scripts/product-agent-tool-mock-eval.ts",
    "verify:hrm": "tsx scripts/verify-hrm.ts"
  },
  "dependencies": {
    "@babel/parser": "7.28.5",
    "@mastra/ai-sdk": "1.11.3",
    "@mastra/core": "1.81.0",
    "@mastra/libsql": "1.28.0",
    "@mastra/memory": "1.41.0",
    "@mastra/observability": "1.24.2",
    "@mastra/voice-openai": "0.13.4",
    "ai": "7.0.162",
    "diff": "9.0.0",
    "playwright": "1.65.0",
    "typescript-language-service": "npm:typescript@5.9.3",
    "yauzl": "3.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/yauzl": "2.10.3",
    "hono": "4.13.16",
    "mastra": "1.37.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
