# 仅用于 docker-compose.gateway-governance.yml 的本地隔离 PoC；不要提交真实值。
LITELLM_GOVERNANCE_MASTER_KEY=sk-governance-local-admin-key
LITELLM_GOVERNANCE_POSTGRES_USER=litellm
LITELLM_GOVERNANCE_POSTGRES_PASSWORD=replace-with-long-local-password
LITELLM_GOVERNANCE_POSTGRES_DB=litellm

# 普通 Runtime 只使用受限 virtual key；master key 仅用于上面的管理操作。
LITELLM_RUNTIME_KEY=sk-governance-local-runtime-key
LITELLM_RUNTIME_TEAM_ID=ai-platform-local
LITELLM_RUNTIME_TEAM_ALIAS=AI Platform Local Runtime
LITELLM_RUNTIME_KEY_ALIAS=ai-platform-local-runtime
LITELLM_RUNTIME_MAX_BUDGET=0.1
LITELLM_RUNTIME_BUDGET_DURATION=1d
LITELLM_RUNTIME_RPM_LIMIT=30
LITELLM_RUNTIME_TPM_LIMIT=20000
LITELLM_BASE_URL=http://127.0.0.1:4100
LITELLM_MODEL=governance-smoke

# 真实 spend smoke 才需要。执行时可用主工作区的 .env 注入，不复制真实 key 到本文件。
# UPSTREAM_API_BASE=https://your-relay.example.com/v1
# UPSTREAM_API_KEY1=sk-your-chat-upstream-key
# UPSTREAM_API_KEY2=sk-your-image-upstream-key
