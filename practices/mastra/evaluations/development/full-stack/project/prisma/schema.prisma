generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Ticket {
  id String @id @default(uuid())
  title String @db.VarChar(120)
  createdAt DateTime @default(now())
}
