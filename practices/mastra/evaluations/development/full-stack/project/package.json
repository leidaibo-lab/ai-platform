{
  "name": "mastra-ticket-stack-pilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "prisma generate --config prisma7.config.ts",
    "migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "build:api": "tsc -p tsconfig.api.json",
    "build:web": "next build --webpack",
    "start:api": "node dist/api/main.js",
    "start:web": "next start -H 0.0.0.0 -p 3000"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.5",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
