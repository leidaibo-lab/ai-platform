# 默认 fixture 无外部模型请求；切换真实模型需明确设置 live 和自己的凭据。
MASTRA_MODE=fixture
OPENAI_API_KEY=
MASTRA_MODEL=openai/gpt-4o-mini
# 自定义网关使用 openai/<网关实际 API model ID>，不要使用带空格的展示名称。
MASTRA_PORT=4111
# 可选：原生 OpenAI-compatible API 基址，应包含网关要求的版本路径。
# 例如 https://input.codes/v1；不要填写完整的 /chat/completions 请求地址。
# 当前原生配置使用 Chat Completions，Responses-only 模型需先核对协议。
MASTRA_BASE_URL=
# 数据目录相对本实践根目录；可用绝对路径进行隔离测试。
MASTRA_DATA_DIR=.data
