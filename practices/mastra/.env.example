MASTRA_MODE=live
MASTRA_MODEL=openai/gpt-5.6-sol
MASTRA_PRODUCT_MODEL=openai/gpt-6-luna
MASTRA_DEVELOPMENT_MODEL=openai/gpt-5.6-luna
MASTRA_DATA_DIR=.data/live
# live 模式使用实际服务凭据；不要提交真实密钥。
OPENAI_API_KEY=
# MASTRA_BASE_URL=https://your-openai-compatible-endpoint/v1
# live产研主流程必须提供部署侧签名清单与独立可信公钥；私钥只留在发布端。
# MASTRA_ARTIFACT_MANIFEST=/absolute/path/to/role-artifact.json
# MASTRA_ARTIFACT_PUBLIC_KEY=/absolute/path/to/trusted-ed25519-public.pem
# 可选：按已冻结制品摘要路由到对应签名清单，支持滚动部署恢复旧Run。
# MASTRA_ARTIFACT_ROUTES={"<artifactDigest>":{"manifestPath":"/release/old/role-artifact.json","publicKeyPath":"/release/old/trusted-ed25519-public.pem"}}
# MASTRA_RUNTIME_CONFIG=/absolute/path/to/workflow.runtime.json
# 远端同步目标必须由服务端登记；页面只能在这些目标之间分配阶段，不能输入路径、Git地址或凭据。
# MASTRA_REMOTE_SYNC_TARGETS=[{"id":"design-flow","label":"设计流程仓库","root":"/absolute/path/to/design-flow","origin":"https://github.com/your-org/design-flow.git"}]
