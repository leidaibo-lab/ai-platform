{
  "name": "ai-platform-mastra-native-practice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "MASTRA_TELEMETRY_DISABLED=1 mastra dev",
    "build": "MASTRA_TELEMETRY_DISABLED=1 mastra build",
    "start": "node .mastra/output/index.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:live": "tsx scripts/smoke.ts --live",
    "delivery": "tsx scripts/delivery.ts",
    "workspace": "tsx scripts/workspace.ts",
    "development": "tsx scripts/development.ts",
    "eval:development": "tsx scripts/development-eval.ts",
    "review:dev": "npm --prefix web run dev",
    "review:build": "npm --prefix web run build",
    "review:preview": "npm --prefix web run preview",
    "eval:product-skills": "tsx scripts/product-skill-eval.ts",
    "product:delivery": "tsx scripts/product-delivery.ts",
    "eval:unified": "tsx scripts/unified-eval.ts"
  },
  "dependencies": {
    "@mastra/ai-sdk": "1.11.3",
    "@mastra/core": "1.81.0",
    "@mastra/libsql": "1.28.0",
    "ai": "7.0.162",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "hono": "4.13.16",
    "mastra": "1.37.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
