{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-platform.local/schemas/runtime-scenario.v1.json",
  "title": "AI Platform Runtime Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "description",
    "supportedModes",
    "prompt",
    "evaluation",
    "runtime",
    "run",
    "fault",
    "deterministicModel",
    "tools"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "runtime-scenario.v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "supportedModes": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["deterministic", "real-model"] }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "system"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "system": { "type": "string", "minLength": 1 }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "maxCompletionTokens"],
      "properties": {
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "maxCompletionTokens": { "type": "integer", "minimum": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runTimeoutMs", "maxToolSteps"],
      "properties": {
        "runTimeoutMs": { "type": "integer", "minimum": 1 },
        "maxToolSteps": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "input"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "requestId",
            "clientMessageId",
            "message",
            "imageUrls",
            "documentUrls",
            "references"
          ],
          "properties": {
            "operation": { "const": "conversation.chat" },
            "requestId": { "type": "string", "minLength": 1 },
            "clientMessageId": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "imageUrls": { "type": "array", "items": { "type": "string" } },
            "documentUrls": { "type": "array", "items": { "type": "string" } },
            "references": { "type": "array" }
          }
        }
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "toolName", "exitCode"],
      "properties": {
        "type": { "const": "process-exit-after-tool-result" },
        "toolName": { "type": "string", "minLength": 1 },
        "exitCode": { "type": "integer", "minimum": 1, "maximum": 255 }
      }
    },
    "deterministicModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "actualModel"],
      "properties": {
        "alias": { "type": "string", "minLength": 1 },
        "actualModel": { "type": "string", "minLength": 1 }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "title",
          "description",
          "effect",
          "inputSchema",
          "requiredOnStart",
          "result"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "effect": { "const": "read" },
          "inputSchema": { "type": "object" },
          "requiredOnStart": { "type": "boolean" },
          "result": {}
        }
      }
    }
  }
}
