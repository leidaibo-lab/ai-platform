# 可选。服务端绑定一个已授权项目，revision 使用该仓库远端 main 的完整 commit SHA。首次发布正式 Run 分支时校验该版本与远端 main 分支头一致。
# MASTRA_ENGINEERING_PROJECT='{"id":"warehouse","label":"仓储盘点","root":"/path/to/warehouse","origin":"https://github.com/example-org/warehouse.git","revision":"0000000000000000000000000000000000000000"}'

# 仅用于旧部署试点图的恢复实例。默认 false，新 Run 采用 MR 交付。
# MASTRA_LEGACY_DEPLOYMENT=false

# 恢复研发节点收敛前创建的 Run。
# MASTRA_LEGACY_DEVELOPMENT_WORKFLOW=false
# MASTRA_DEVELOPMENT_CONTINUATION_LIMIT=4
# MASTRA_PLATFORM_REPAIR_TOKEN=

# 恢复包含产品澄清整理与优先级节点的历史四段图。
# MASTRA_LEGACY_PRODUCT_WORKFLOW=false
# 恢复 product-team.draft-product 下的历史三阶段图。
# MASTRA_NESTED_PRODUCT_WORKFLOW=false
# 恢复 product-direction 和 product-specification 均为子流程的历史三阶段图。
# MASTRA_NATIVE_THREE_STAGE_PRODUCT_WORKFLOW=false

# 本地浏览器 QA 调试。true 会在运行后端的桌面上打开 Chromium 窗口。
# MASTRA_BROWSER_QA_HEADED=false
