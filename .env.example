# Runtime 和模型连通性诊断访问内部 LiteLLM 的服务端凭据；不提供给浏览器或普通业务客户端。
LITELLM_MASTER_KEY=sk-local-admin-key

# Runtime 通过 AI SDK 的 OpenAI-compatible Provider 调用 LiteLLM。
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MODEL=chat-default

# 你的中转站 OpenAI-compatible 地址，通常需要带 /v1。
UPSTREAM_API_BASE=https://your-relay.example.com/v1

# 你的中转站真实 key。只放服务端，不要提交到 git。
UPSTREAM_API_KEY=sk-your-upstream-key

# Runtime 会话数据库和上下文策略；相对路径以项目根目录为基准。
DEMO_DATABASE_PATH=.data/ai-platform.sqlite
DEMO_MAX_CONTEXT_TOKENS=12000
DEMO_RESERVED_OUTPUT_TOKENS=2000
DEMO_CONTEXT_SAFETY_TOKENS=500
DEMO_CONTEXT_HIGH_WATERMARK_RATIO=0.75
DEMO_CONTEXT_LOW_WATERMARK_RATIO=0.45
DEMO_CONTEXT_HARD_WATERMARK_RATIO=0.9
DEMO_MEMORY_MAX_COMPLETION_TOKENS=1200
