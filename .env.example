# Runtime 和模型连通性诊断访问内部 LiteLLM 的服务端凭据；不提供给浏览器或普通业务客户端。
LITELLM_MASTER_KEY=sk-local-admin-key

# Runtime 通过 AI SDK 的 OpenAI-compatible Provider 调用 LiteLLM。
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MODEL=chat-default

# 你的中转站 OpenAI-compatible 地址，通常需要带 /v1。
UPSTREAM_API_BASE=https://your-relay.example.com/v1

# 你的中转站真实 key。只放服务端，不要提交到 git。
UPSTREAM_API_KEY=sk-your-upstream-key

# Runtime 会话数据库和上下文策略；相对路径以项目根目录为基准。
DEMO_DATABASE_PATH=.data/ai-platform.sqlite
DEMO_MAX_CONTEXT_TOKENS=12000
DEMO_RESERVED_OUTPUT_TOKENS=2000
DEMO_CONTEXT_SAFETY_TOKENS=500
DEMO_CONTEXT_HIGH_WATERMARK_RATIO=0.75
DEMO_CONTEXT_LOW_WATERMARK_RATIO=0.45
DEMO_CONTEXT_HARD_WATERMARK_RATIO=0.9
DEMO_MEMORY_MAX_COMPLETION_TOKENS=1200

# 单次 Run 共享总时限和模型阶段重试策略；最大尝试次数包含首次调用。
DEMO_RUN_TIMEOUT_MS=120000
DEMO_MODEL_MAX_ATTEMPTS=3
DEMO_MODEL_RETRY_BASE_DELAY_MS=500
DEMO_MODEL_RETRY_MAX_DELAY_MS=5000

# V1 只读工具循环；天气工具只访问代码内固定的 Open-Meteo HTTPS 端点。
DEMO_TOOL_MAX_STEPS=4
DEMO_WEATHER_TOOL_ENABLED=true
DEMO_WEATHER_TIMEOUT_MS=8000

# Phoenix 19.10.0 + PostgreSQL 17 正式 ChainTrace 后端；值只放服务端 .env。
# PostgreSQL 密码会进入连接 URL，请使用只包含字母、数字和 ._~- 的长随机值。
PHOENIX_POSTGRES_USER=phoenix
PHOENIX_POSTGRES_PASSWORD=replace-with-long-url-safe-password-1
PHOENIX_POSTGRES_DB=phoenix
PHOENIX_HOST_PORT=6006
PHOENIX_SECRET=replace-with-32-char-random-secret-1
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=Replace-With-Strong-Admin-Password-1!

# C1 ChainTrace 默认关闭；启用后通过 OTLP/HTTP protobuf 旁路导出到 Phoenix。
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:6006/v1/traces
# 在 Phoenix 设置页创建 system API key；空格必须按 OTel header 规范编码为 %20。
OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=Bearer%20replace-with-phoenix-system-api-key
OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=10000
OTEL_SERVICE_NAME=ai-platform-demo

# 正式 ChainTrace 固定使用 parentbased_traceidratio，参数范围为 0 到 1。
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1

# C1 ChainTrace 双后端对比 PoC；只由独立 runner 使用，不进入 Demo Server 正式配置。
CHAIN_TRACE_POC_TARGETS=both
CHAIN_TRACE_POC_LANGFUSE_ENDPOINT=http://localhost:3000/api/public/otel/v1/traces
CHAIN_TRACE_POC_LANGFUSE_PUBLIC_KEY=pk-lf-poc-example
CHAIN_TRACE_POC_LANGFUSE_SECRET_KEY=sk-lf-poc-example
CHAIN_TRACE_POC_PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
CHAIN_TRACE_POC_PHOENIX_API_KEY=
